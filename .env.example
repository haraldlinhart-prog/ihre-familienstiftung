# Pflicht, damit das Kontaktformular Nachrichten annimmt.
# Fehlt der Schlüssel, bricht der Build nicht ab. Die Route antwortet zur Laufzeit mit einem Hinweis.
RESEND_API_KEY=

# Pflicht für die HMAC-Signatur des Formularzeitstempels. Langer Zufallswert, kein Personenbezug.
CONTACT_FORM_SECRET=

# Optional. Absender muss bei Resend für die Domain freigeschaltet sein.
CONTACT_FROM=Ihre Familienstiftung <kontakt@pan21.com>

# Optional. Empfänger der Formularnachrichten.
CONTACT_TO=familienstiftung@pan21.com
